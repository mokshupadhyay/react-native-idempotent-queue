{
  "name": "react-native-idempotent-queue",
  "version": "0.1.1",
  "description": "A persistent request queue for React Native that saves each state-changing request before sending it, retries it with the same idempotency key after failures and app restarts, and never sends it in parallel with itself. JavaScript only, so it works on the old and new architecture.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com>",
  "homepage": "https://github.com/mokshupadhyay/react-native-idempotent-queue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/react-native-idempotent-queue.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/react-native-idempotent-queue/issues"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "idempotency",
    "idempotency-key",
    "offline",
    "queue",
    "retry",
    "backoff",
    "payments",
    "async-storage",
    "netinfo",
    "new-architecture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "@react-native-community/netinfo": ">=5.0.0",
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "fast-check": "^4.10.3",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
